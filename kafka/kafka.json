    {
      "id": 6,
      "type": "timeseries",
      "title": "Поток событий",
      "description": "Это метрики приложений: они показывают, сколько событий сервисы реально отправляют и получают.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(kafka_messages_sent_total[5m]))",
          "legendFormat": "Публикация",
          "refId": "A"
        },
        {
          "expr": "sum(rate(kafka_messages_received_total[5m]))",
          "legendFormat": "Получение",
          "refId": "B"
        }
      ],
      "fieldConfig": {
