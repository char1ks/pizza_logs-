      "options": {
        "mode": "markdown",
        "content": "Это экран для ответа на один вопрос: **какой контейнер съедает ресурсы?**\n\nЗапусти нагрузочный тест на главной странице и смотри, какая линия CPU растёт первой."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU по микросервисам",
      "description": "",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*frontend.*\"}[5m]) * 100",
          "legendFormat": "Frontend",
          "refId": "A"
        },
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*order.*\"}[5m]) * 100",
          "legendFormat": "Order",
          "refId": "B"
        },
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*payment.*\"}[5m]) * 100",
          "legendFormat": "Payment",
          "refId": "C"
        },
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*notification.*\"}[5m]) * 100",
          "legendFormat": "Notification",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "lineWidth": 2,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
