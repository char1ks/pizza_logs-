    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_database_queries_blocks_hit)/clamp_min(sum(pg_database_queries_blocks_hit)+sum(pg_database_queries_blocks_fetched),1)*100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
