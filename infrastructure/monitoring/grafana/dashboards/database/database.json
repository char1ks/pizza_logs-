    {
      "id": 8,
      "type": "timeseries",
      "title": "Seq scan и Index scan",
      "description": "Большой рост Seq scan на горячих таблицах — повод проверить индексы.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(schemaname)(rate(pg_database_performance_seq_scan[5m]))",
          "legendFormat": "Seq · {{schemaname}}"
        },
        {
          "refId": "B",
          "expr": "sum by(schemaname)(rate(pg_database_performance_idx_scan[5m]))",
          "legendFormat": "Index · {{schemaname}}"
        }
      ],
      "fieldConfig": {
