{
  "annotations": {
    "list": []
  },
  "description": "Поиск медленного или падающего микросервиса: трафик → ошибки → задержка → ресурсы.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panelId": 0,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Как найти проблему",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Иди сверху вниз\n**Rate** — приходит ли нагрузка.  \n**5xx** — отвечает ли сервис ошибками.  \n**P95** — не стал ли он медленным.  \n**CPU / RAM** — не упёрся ли контейнер в ресурсы."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Доступны",
      "description": "",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"frontend-service|order-service|payment-service|notification-service|payment-mock\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
